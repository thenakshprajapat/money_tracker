rules_version = '2';

// My Money security rules.
// All data lives under users/{uid}/... and is readable/writable only by that user.
// The lock rule on transactions is the real guarantee; the UI only mirrors it.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Lock period in days, from the user's settings document (default 7).
    function lockDays(database, uid) {
      let path = /databases/$(database)/documents/users/$(uid)/settings/main;
      return exists(path) ? get(path).data.lockDays : 7;
    }

    // A transaction is editable only until createdAt + lockDays.
    function isUnlocked(database, uid, existing) {
      return request.time < existing.createdAt + duration.value(lockDays(database, uid), 'd');
    }

    function validTx(d) {
      return d.keys().hasOnly([
               'type', 'amountPaise', 'date', 'accountId', 'toAccountId',
               'sourceId', 'note', 'createdAt', 'updatedAt'
             ])
             && d.keys().hasAll([
               'type', 'amountPaise', 'date', 'accountId', 'toAccountId',
               'sourceId', 'note', 'createdAt', 'updatedAt'
             ])
             && d.type in ['income', 'expense', 'transfer']
             && d.amountPaise is int && d.amountPaise > 0 && d.amountPaise < 100000000000
             && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
             && d.accountId is string && d.accountId.size() > 0 && d.accountId.size() <= 40
             && d.note is string && d.note.size() <= 500
             && d.createdAt is timestamp && d.updatedAt is timestamp
             && (
               // Transfer: one linked record, two different accounts, no source.
               (d.type == 'transfer'
                 && d.toAccountId is string
                 && d.toAccountId.size() > 0
                 && d.toAccountId != d.accountId
                 && d.sourceId == null)
               ||
               // Income / expense: one account, one source.
               (d.type in ['income', 'expense']
                 && d.toAccountId == null
                 && d.sourceId in ['mom', 'dad', 'rent', 'personal']
                 && (d.sourceId == 'personal' || d.type == 'income'))
             );
    }

    match /users/{uid} {

      match /settings/{docId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && docId == 'main'
          && request.resource.data.keys().hasOnly(['lockDays'])
          && request.resource.data.lockDays is int
          && request.resource.data.lockDays >= 1
          && request.resource.data.lockDays <= 3650;
        allow delete: if false;
      }

      match /accounts/{accountId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['name', 'openingPaise', 'order'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && request.resource.data.openingPaise is int
          && request.resource.data.order is int;
        allow delete: if false;
      }

      match /transactions/{txId} {
        allow read: if isOwner(uid);

        allow create: if isOwner(uid)
          && validTx(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isOwner(uid)
          && isUnlocked(database, uid, resource.data)
          && validTx(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;

        allow delete: if isOwner(uid)
          && isUnlocked(database, uid, resource.data);
      }
    }
  }
}
